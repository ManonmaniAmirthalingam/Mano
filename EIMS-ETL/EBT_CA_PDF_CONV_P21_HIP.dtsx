                                SQLTask:ResultName="0"
                                SQLTask:DtsVariableName="User::EBTDC729_RPT_INFO" />
                              <SQLTask:ParameterBinding
                                SQLTask:ParameterName="@GENERATED_DATE"
                                SQLTask:DtsVariableName="User::EBTDC729_GENERATED_DATE"
                                SQLTask:ParameterDirection="Input"
                                SQLTask:DataType="129"
                                SQLTask:ParameterSize="-1" />
                              <SQLTask:ParameterBinding
