                  SQLTask:SqlStatementSource="SELECT DISTINCT GENERATED_DATE FROM&#xA;(&#xA;SELECT &#xA;LTRIM(RTRIM(REVERSE&#xA;(&#xA; SUBSTRING&#xA;  (&#xA;   REVERSE(RPT_NME),&#xA;   CHARINDEX('_',REVERSE(RPT_NME))+1,&#xA;   (CHARINDEX('-',REVERSE(RPT_NME))-CHARINDEX('_',REVERSE(RPT_NME)))-1&#xA;  )&#xA;))) RPT_INFO, CA.*&#xA;FROM TB_SPF_FILE_SORT_CA(NOLOCK) CA&#xA;WHERE  FILE_EXT='TXT')A &#xA;WHERE RPT_INFO='EBTDC729'&#xA;ORDER BY GENERATED_DATE ASC"
                  SQLTask:ResultType="ResultSetType_Rowset" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
