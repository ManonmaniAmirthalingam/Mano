                              SQLTask:Connection="{6CB51CD2-D7C2-4833-AA16-03237A863771}"
                              SQLTask:SqlStatementSource="&#xA;DECLARE @GENERATED_DATE VARCHAR(10) = ?&#xA;DECLARE @LOCAL_PATH VARCHAR(500) = ?&#xA;DECLARE @SERVER_PATH VARCHAR(500) = ?&#xA;&#xA;SELECT CONCAT(LVL1,'|',LVL2,'|',LVL3,'|',RPT_CAT,'|',RPT_INFO,'|',LTRIM(RTRIM(REPLACE(FILENAME1,@LOCAL_PATH,@SERVER_PATH))),'|',A.RPT_NME,'|',FLTR_TYP,'|',LTRIM(RTRIM(REVERSE(SUBSTRING(REVERSE(FILENAME1),0,CHARINDEX('-',REVERSE(FILENAME1)))))),'|',LTRIM(RTRIM(REVERSE(SUBSTRING(REVERSE(REPLACE(FILENAME1,@LOCAL_PATH,@SERVER_PATH)),CHARINDEX('\',REVERSE(REPLACE(FILENAME1,@LOCAL_PATH,@SERVER_PATH)))+1,LEN(FILENAME1))))),'|',RDL_NME,'|',FILENAME1,'|',(RDL_NME+'.pdf'),'|',STG_TBL_NME) FROM &#xA;(&#xA;SELECT &#xA;LTRIM(RTRIM(REVERSE&#xA;(&#xA; SUBSTRING&#xA;  (&#xA;   REVERSE(RPT_NME),&#xA;   CHARINDEX('_',REVERSE(RPT_NME))+1,&#xA;   (CHARINDEX('-',REVERSE(RPT_NME))-CHARINDEX('_',REVERSE(RPT_NME)))-1&#xA;  )&#xA;))) RPT_INFO, CA.*&#xA;FROM TB_SPF_FILE_SORT_CA(NOLOCK) CA&#xA;WHERE  FILE_EXT='TXT' &#xA;)A&#xA;LEFT JOIN TB_EBT_RPT_MSTR(NOLOCK) MSTR ON A.RPT_INFO = MSTR.RPT_ID&#xA;WHERE RPT_INFO='EBTDC729' &#xA;AND GENERATED_DATE = @GENERATED_DATE&#xA;ORDER BY LVL1,LVL2,LVL3"
                              SQLTask:ResultType="ResultSetType_Rowset" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
