                                  SQLTask:Connection="{6CB51CD2-D7C2-4833-AA16-03237A863771}"
                                  SQLTask:SqlStatementSource=";WITH CTE AS&#xA;(&#xA;SELECT ROW_NUMBER() OVER(ORDER BY PRCS_DTE) RW_ID,FILENAME1 FROM TB_SPF_FILE_SORT_CA(NOLOCK)&#xA;WHERE FILENAME1 = ?&#xA;)&#xA;DELETE FROM CTE WHERE RW_ID=1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
