    <DTS:Executable
      DTS:refId="Package\Get Last 7 days"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Get Last 7 days"
      DTS:Disabled="True"
      DTS:DTSID="{F16130A4-7A08-413B-8BD2-4703E8E8EA0F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Get Last 7 days"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2016; © 2015 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{36A98BC5-AF46-4CD6-8815-203984F9E666}"
          SQLTask:SqlStatementSource="&#xA;WITH CTE (STATE,AGENCY,COUNTY,DATE,DATE_PART,RPT_CAT,RPT_NME,RPT_ID,FILE_NAME_1,VER_NBR,PRCS_DTE,RN)  &#xA;AS  &#xA;                (  &#xA;    &#xA;                SELECT *,ROW_NUMBER() OVER (PARTITION BY STATE,AGENCY,COUNTY,RPT_NME ORDER BY DATE_PART DESC) RN  &#xA;                FROM&#xA;                                (&#xA;                                SELECT  &#xA;                                LVL1 AS STATE,&#xA;                                LVL2 AS AGENCY,&#xA;                                LVL3 AS COUNTY,&#xA;                                FORMAT(Convert(date,GENERATED_DATE),'MM/dd/yy') AS DATE,&#xA;                                GENERATED_DATE AS DATE_PART,&#xA;                                RPT_CAT AS RPT_CAT,&#xA;                                SUBSTRING(RPT_NME,0,CHARINDEX('-',RPT_NME)) AS RPT_NME,&#xA;                                REVERSE(SUBSTRING&#xA;                                (&#xA;                REVERSE(REVERSE(SUBSTRING(REVERSE(FILENAME1),CHARINDEX('_',REVERSE(FILENAME1))+1,(CHARINDEX('\',REVERSE(FILENAME1))-CHARINDEX('-',REVERSE(FILENAME1)))+1))),&#xA;                                0,&#xA;                                CHARINDEX(' ',REVERSE(REVERSE(SUBSTRING(REVERSE(FILENAME1),CHARINDEX('_',REVERSE(FILENAME1))+1,(CHARINDEX('\',REVERSE(FILENAME1))-CHARINDEX('-',REVERSE(FILENAME1)))+1))))&#xA;                                )) AS RPT_ID,&#xA;                                FILENAME1 AS FILE_NAME_1,&#xA;                                MAX(VER_NBR) AS VER_NBR,&#xA;                                MAX(PRCS_DTE) AS PRCS_DTE&#xA;                                FROM  TB_SPF_FILE_SORT(NOLOCK)&#xA;                                WHERE FILE_EXT='TXT' AND LVL1&lt;&gt;'CA'&#xA;                                GROUP BY LVL1,LVL2,LVL3,GENERATED_DATE,RPT_CAT,RPT_NME,FILENAME1&#xA;                                ) A &#xA;                ) &#xA;&#xA;INSERT INTO TB_EBT_LST_7_RPT_DTE    &#xA;SELECT STATE,AGENCY,COUNTY,DATE,DATE_PART,RPT_CAT,RPT_NME,RPT_ID,FILE_NAME_1,VER_NBR FROM CTE WHERE RN&lt;=7  &#xA;ORDER BY STATE,AGENCY,COUNTY,RPT_NME,DATE_PART DESC&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Get Left Over Info"
