          <DTS:PropertyExpression
            DTS:Name="Arguments">"(Get-ChildItem -Path " +  "\""+ @[User::ServerSorcePath] + "\"" + " -Recurse -Include *.*  | Format-Table -Wrap -AutoSize -HideTableHeaders @{Name="+"'FullName"+"';Expression={$_.FullName +"+"'|'}}, @{Name="+"'LastWriteTime';Expression={"+"'|' +$_.LastWriteTime.ToString("+"'yyyy-MM-dd HH:mm:ss') }}|Out-String -Width 10000).trim()| out-file E:\\FileNames_LeftOver.txt"</DTS:PropertyExpression>
          <DTS:ObjectData>
            <ExecuteProcessData
              Executable="C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe"
              Arguments="(Get-ChildItem -Path &quot;\\BDC8WNAREBTAP03\Reports\govOrganizationReports&quot; -Recurse -Include *.*  | Format-Table -Wrap -AutoSize -HideTableHeaders @{Name='FullName';Expression={$_.FullName +'|'}}, @{Name='LastWriteTime';Expression={'|' +$_.LastWriteTime.ToString('yyyy-MM-dd HH:mm:ss') }}|Out-String -Width 10000).trim()| out-file E:\FileNames_LeftOver.txt" />
