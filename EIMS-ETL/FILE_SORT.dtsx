      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{36A98BC5-AF46-4CD6-8815-203984F9E666}"
          SQLTask:SqlStatementSource="&#xA;DECLARE @STAT VARCHAR(1000) =?&#xA;DECLARE @RecentFilNme VARCHAR(1000) =?&#xA;&#xA;UPDATE  [ETL_PKG_RUN_LOG]&#xA;SET STAT='S',&#xA;END_TME=getdate(),&#xA;[DESCRIPTION]=@STAT,&#xA;FileNme=@RecentFilNme&#xA;WHERE [PKG_NME]= 'FILE_SORT' and STAT='R' and END_TME is null" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="@STAT"
            SQLTask:DtsVariableName="User::PKG_END"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="@RecentFilNme"
            SQLTask:DtsVariableName="User::OUT_Varble"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
