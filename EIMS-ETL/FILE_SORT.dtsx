          DTS:ObjectName="Retain Useful"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{36A98BC5-AF46-4CD6-8815-203984F9E666}"
              SQLTask:SqlStatementSource="DELETE FROM TB_SPF_FILE_SORT_LFT_OVR WHERE FILENAME1 NOT LIKE '%.txt%' AND FILENAME1 NOT LIKE '%.pdf%' AND FILENAME1 NOT LIKE '%.csv%' " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Get Left Over Info\Update Hierarchy"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{B9E2E8D1-0F71-43CD-8700-3529719F61A8}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="16393"
          DTS:ObjectName="Update Hierarchy"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{36A98BC5-AF46-4CD6-8815-203984F9E666}"
              SQLTask:SqlStatementSource="&#xA;;WITH T(FILENAME1,FILENME, STARTS, POS) AS (&#xA;    SELECT  FILENAME1,SUBSTRING(FILENAME1,CHARINDEX('govOrganizationReportsMirror\',FILENAME1),LEN(FILENAME1)) FILENAME1, 1, CHARINDEX('\', FILENAME1) POS &#xA;       FROM TB_SPF_FILE_SORT_LFT_OVR&#xA;    UNION ALL&#xA;    SELECT FILENAME1,FILENME, POS + 1, CHARINDEX('\', FILENME, POS + 1)&#xA;    FROM T&#xA;    WHERE POS &gt; 0&#xA;)&#xA;SELECT &#xA;    *, SUBSTRING(FILENME, STARTS, CASE WHEN POS &gt; 0 THEN POS - STARTS ELSE LEN(FILENME) END) TOKEN,ROW_NUMBER()OVER(PARTITION BY FILENME ORDER BY STARTS) RNO INTO #TEMP&#xA;FROM T&#xA;ORDER BY FILENME, STARTS&#xA;&#xA;&#xA;&#xA;UPDATE TB_SPF_FILE_SORT_LFT_OVR&#xA;SET LVL1=A.TOKEN&#xA;FROM #TEMP A&#xA;JOIN TB_SPF_FILE_SORT_LFT_OVR SORT ON A.FILENAME1=SORT.FILENAME1&#xA;WHERE RNO=3 AND SORT.FILENAME1=A.FILENAME1&#xA;&#xA;UPDATE TB_SPF_FILE_SORT_LFT_OVR&#xA;SET LVL2=A.TOKEN&#xA;FROM #TEMP A&#xA;JOIN TB_SPF_FILE_SORT_LFT_OVR SORT ON A.FILENAME1=SORT.FILENAME1&#xA;WHERE RNO=4 AND SORT.FILENAME1=A.FILENAME1&#xA;&#xA;UPDATE TB_SPF_FILE_SORT_LFT_OVR&#xA;SET LVL3=A.TOKEN&#xA;FROM #TEMP A&#xA;JOIN TB_SPF_FILE_SORT_LFT_OVR SORT ON A.FILENAME1=SORT.FILENAME1&#xA;WHERE RNO=5 AND SORT.FILENAME1=A.FILENAME1&#xA;&#xA;UPDATE TB_SPF_FILE_SORT_LFT_OVR&#xA;SET RPT_CAT=A.TOKEN&#xA;FROM #TEMP A&#xA;JOIN TB_SPF_FILE_SORT_LFT_OVR SORT ON A.FILENAME1=SORT.FILENAME1&#xA;WHERE RNO=6 AND SORT.FILENAME1=A.FILENAME1&#xA;&#xA;UPDATE A&#xA;SET A.VER_NBR = B.VER_NBR+1&#xA;FROM TB_SPF_FILE_SORT_LFT_OVR A&#xA;JOIN TB_SPF_RPT_VER B ON A.FILENAME1 = B.FILENAME1&#xA;&#xA;UPDATE TB_SPF_FILE_SORT_LFT_OVR&#xA;SET TB_SPF_FILE_SORT_LFT_OVR.VER_NBR = 1&#xA;WHERE TB_SPF_FILE_SORT_LFT_OVR.VER_NBR IS NULL" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
