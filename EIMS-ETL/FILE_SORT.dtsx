  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\CA Table Insert"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{6984BA82-C1F8-48F7-839B-E0AE2417466B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CA Table Insert"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2016; © 2015 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{36A98BC5-AF46-4CD6-8815-203984F9E666}"
          SQLTask:SqlStatementSource="INSERT INTO TB_SPF_FILE_SORT_CA&#xA;  SELECT * FROM TB_SPF_FILE_SORT_PDF&#xA;where LVL1='CA' AND RPT_CAT NOT LIKE 'FIS%';&#x9;&#x9;&#xA;&#x9;&#x9;&#xA;INSERT INTO TB_EBT_LST_7_RPT_DTE&#xA;SELECT   FS.LVL1, FS.LVL2, FS.LVL3, FS.GENERATED_DATE, FS.[DATETIME], FS.RPT_CAT, FS.RPT_NME, &#xA;replace(LTRIM(Substring(reverse(SUBSTRING(REVERSE(FS.RPT_NME),CHARINDEX('_',REVERSE(FS.RPT_NME),2),20)),9,11)),'- ','') RPT_ID,&#xA;FS.FILENAME1,  FS.VER_NBR&#xA;FROM TB_SPF_FILE_SORT_PDF(NOLOCK) FS                           &#xA; LEFT JOIN TB_EBT_LST_7_RPT_DTE LST7 on FS.LVL1 = LST7.[STATE] AND FS.LVL2 = LST7.AGENCY  AND FS.LVL3 = LST7.COUNTY  &#xA;AND LST7.RPT_ID = replace(LTRIM(Substring(reverse(SUBSTRING(REVERSE(FS.RPT_NME),CHARINDEX('_',REVERSE(FS.RPT_NME),2),20)),9,11)),'- ','')&#xA;AND FS.RPT_NME = LST7.RPT_NME&#xA;WHERE FS.FILE_EXT = 'TXT' &#xA;AND LST7.RPT_ID  IS   NULL&#xA;&#xA;&#xA;;WITH CTE AS&#xA;(SELECT * , DENSE_RANK() over(Partition by STATE, AGENCY, COUNTY,RPT_ID ORDER BY DATE desc  ) AS RK FROM TB_EBT_LST_7_RPT_DTE LST7  ) &#xA;DELETE  FROM CTE WHERE RK &gt; 7 " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Call Job"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{9658999F-E532-4642-A429-871868D55226}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Call Job"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2016; © 2015 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{36A98BC5-AF46-4CD6-8815-203984F9E666}"
          SQLTask:SqlStmtSourceType="Variable"
          SQLTask:SqlStatementSource="User::PKG_Call" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Check Last Run Status"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F10DCD95-93A7-4EBE-9A60-1DCEFD516DF2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="16393"
      DTS:ObjectName="Check Last Run Status"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2016; © 2015 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{36A98BC5-AF46-4CD6-8815-203984F9E666}"
          SQLTask:SqlStatementSource="Select COUNT(1) CNT from [ETL_PKG_RUN_LOG]&#xA;where STAT in('R') and [PKG_NME]='FILE_SORT'"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="CNT"
            SQLTask:DtsVariableName="User::CHK_FLG" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\COMPARE PDF AND LFTOVR"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{46B6B4A2-79BA-411A-97DA-DC6A2A3D1DC7}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="COMPARE PDF AND LFTOVR"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{36A98BC5-AF46-4CD6-8815-203984F9E666}"
          SQLTask:SqlStatementSource="SELECT COUNT(1) AS CHK_CNT FROM TB_SPF_FILE_SORT_LFT_OVR FLE &#xA;LEFT JOIN TB_SPF_FILE_SORT_PDF PDF ON FLE.RPT_NME=PDF.RPT_NME and fle.lvl1=pdf.lvl1 and fle.lvl2=pdf.lvl2 and  fle.lvl3 =pdf.lvl3 &#xA;WHERE PDF.RPT_NME IS NULL AND FLE.LVL1 &lt;&gt; 'CA' AND FLE.FILE_EXT = 'TXT'"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="CHK_CNT"
            SQLTask:DtsVariableName="User::CHK_CNT" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Copy from Network to Local Path"
      DTS:CreationName="Microsoft.ExecuteProcess"
      DTS:Description="Execute Process Task"
      DTS:DTSID="{2DA9B938-85CB-4ABE-8FDC-0AEE8293E537}"
      DTS:ExecutableType="Microsoft.ExecuteProcess"
      DTS:LocaleID="16393"
      DTS:ObjectName="Copy from Network to Local Path"
      DTS:ThreadHint="0">
