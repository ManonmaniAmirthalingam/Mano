      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{36A98BC5-AF46-4CD6-8815-203984F9E666}"
          SQLTask:SqlStatementSource="INSERT INTO ETL_PKG_RUN_LOG(PKG_NME,DESCRIPTION,PRCS_DTE,STAT)&#xA;VALuES ('FILE_SORT','The Package Execution Started',getdate(),'R')" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
