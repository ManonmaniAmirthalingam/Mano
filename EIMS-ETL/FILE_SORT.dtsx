          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{36A98BC5-AF46-4CD6-8815-203984F9E666}"
              SQLTask:SqlStatementSource="UPDATE &#xA;TB_SPF_FILE_SORT_LFT_OVR&#xA;SET&#xA;DATETIME=REVERSE(SUBSTRING(REVERSE(FILENAME1),CHARINDEX('.',REVERSE(FILENAME1))+1,CHARINDEX('_',REVERSE(FILENAME1))-CHARINDEX('.',REVERSE(FILENAME1))-1)),&#xA;GENERATED_DATE=SUBSTRING((REVERSE(SUBSTRING(REVERSE(FILENAME1),CHARINDEX('.',REVERSE(FILENAME1))+1,CHARINDEX('_',REVERSE(FILENAME1))-CHARINDEX('.',REVERSE(FILENAME1))-1))),0,7),&#xA;GENERATED_TIME=CASE WHEN LEN(REVERSE(SUBSTRING(REVERSE(FILENAME1),CHARINDEX('.',REVERSE(FILENAME1))+1,CHARINDEX('_',REVERSE(FILENAME1))-CHARINDEX('.',REVERSE(FILENAME1))-1)))&gt;6 THEN SUBSTRING((REVERSE(SUBSTRING(REVERSE(FILENAME1),CHARINDEX('.',REVERSE(FILENAME1))+1,CHARINDEX('_',REVERSE(FILENAME1))-CHARINDEX('.',REVERSE(FILENAME1))-1))),8,5) ELSE '' END,&#xA;FILE_EXT=RIGHT(FILENAME1,3),&#xA;RPT_NME=REVERSE(SUBSTRING(REVERSE(FILENAME1),CHARINDEX('.',REVERSE(FILENAME1),0)+1,CHARINDEX('\',REVERSE(FILENAME1),0)-CHARINDEX('.',REVERSE(FILENAME1),0)-1)),&#xA;PRCS_DTE= GETDATE()&#xA;FROM TB_SPF_FILE_SORT_LFT_OVR" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
