    <DTS:Executable
      DTS:refId="Package\Truncate Table"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{4E54CB6B-BB09-4EF5-B00E-14385AF9CA52}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="16393"
      DTS:ObjectName="Truncate Table"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017 RC1; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0099097C-2930-417B-9536-1D85BEB61E54}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE TB_SPF_FILE_SORT_PDF" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Update Hierarchy"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{E96205AD-D504-4731-AB17-C2BEC75F58A0}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="16393"
      DTS:ObjectName="Update Hierarchy"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0099097C-2930-417B-9536-1D85BEB61E54}"
          SQLTask:SqlStatementSource=";WITH T(FILENAME1,FILENME, STARTS, POS) AS (&#xA;    SELECT  FILENAME1,SUBSTRING(FILENAME1,CHARINDEX('govOrganizationReportsMirror\',FILENAME1),LEN(FILENAME1)) FILENAME1, 1, CHARINDEX('\', FILENAME1) POS &#xA;       FROM TB_SPF_FILE_SORT_PDF&#xA;    UNION ALL&#xA;    SELECT FILENAME1,FILENME, POS + 1, CHARINDEX('\', FILENME, POS + 1)&#xA;    FROM T&#xA;    WHERE POS &gt; 0&#xA;)&#xA;SELECT &#xA;    *, SUBSTRING(FILENME, STARTS, CASE WHEN POS &gt; 0 THEN POS - STARTS ELSE LEN(FILENME) END) TOKEN,ROW_NUMBER()OVER(PARTITION BY FILENME ORDER BY STARTS) RNO INTO #TEMP&#xA;FROM T&#xA;ORDER BY FILENME, STARTS&#xA;&#xA;&#xA;&#xA;UPDATE TB_SPF_FILE_SORT_PDF&#xA;SET LVL1=A.TOKEN&#xA;FROM #TEMP A&#xA;JOIN TB_SPF_FILE_SORT_PDF SORT ON A.FILENAME1=SORT.FILENAME1&#xA;WHERE RNO=3 AND SORT.FILENAME1=A.FILENAME1&#xA;&#xA;UPDATE TB_SPF_FILE_SORT_PDF&#xA;SET LVL2=A.TOKEN&#xA;FROM #TEMP A&#xA;JOIN TB_SPF_FILE_SORT_PDF SORT ON A.FILENAME1=SORT.FILENAME1&#xA;WHERE RNO=4 AND SORT.FILENAME1=A.FILENAME1&#xA;&#xA;UPDATE TB_SPF_FILE_SORT_PDF&#xA;SET LVL3=A.TOKEN&#xA;FROM #TEMP A&#xA;JOIN TB_SPF_FILE_SORT_PDF SORT ON A.FILENAME1=SORT.FILENAME1&#xA;WHERE RNO=5 AND SORT.FILENAME1=A.FILENAME1&#xA;&#xA;UPDATE TB_SPF_FILE_SORT_PDF&#xA;SET RPT_CAT=A.TOKEN&#xA;FROM #TEMP A&#xA;JOIN TB_SPF_FILE_SORT_PDF SORT ON A.FILENAME1=SORT.FILENAME1&#xA;WHERE RNO=6 AND SORT.FILENAME1=A.FILENAME1&#xA;&#xA;UPDATE A&#xA;SET A.VER_NBR = B.VER_NBR+1&#xA;FROM TB_SPF_FILE_SORT_PDF A&#xA;JOIN TB_SPF_RPT_VER B ON A.FILENAME1 = B.FILENAME1&#xA;&#xA;UPDATE TB_SPF_FILE_SORT_PDF&#xA;SET TB_SPF_FILE_SORT_PDF.VER_NBR = 1&#xA;WHERE TB_SPF_FILE_SORT_PDF.VER_NBR IS NULL" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
